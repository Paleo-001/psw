# Save the output of this file and use kubectl create -f to import
# it into Kubernetes.
#
# Created with podman-4.9.3

# NOTE: If you generated this yaml from an unprivileged and rootless podman container on an SELinux
# enabled system, check the podman generate kube man page for steps to follow to ensure that your pod/container
# has the right permissions to access the volumes added.
---
apiVersion: v1
kind: Pod
metadata:
  creationTimestamp: "2026-08-12T22:07:36Z"
  labels:
    app: Nodejs-pod
  name: Nodejs-pod
spec:
  containers:
  - args:
    - node
    env:
    - name: TERM
      value: xterm
    image: docker.io/library/node:latest
    name: Nodejs
    ports:
    - containerPort: 3000
      hostPort: 3000
    stdin: true
    tty: true
    volumeMounts:
    - mountPath: /usr/srv/app
      name: var-www-psw-host-0
  volumes:
  - hostPath:
      path: /var/www/psw
      type: Directory
    name: var-www-psw-host-0
