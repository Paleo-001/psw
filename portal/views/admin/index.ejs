<%- include('../partials/header'); %>
<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Administração dos Artigos</h2>
        <a href="/admin/novo" class="btn btn-success">Novo</a>
    </div>
    <table class="table table-striped table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Título</th>
                <th>Destaque</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            <% artigos.forEach(artigo => { %>
                <tr>
                    <td><%= artigo. titulo %></td>
                    <td><%= artigo.destaque ? 'Sim' : 'Não' %></td>
                    <td>
                        <a href="/admin/editar/<%= artigo._id %>" class="btn btn-warning btn-sm">Editar</a>
                        <form action="/admin/excluir/<%= artigo._id %>" method="post" class="d-inline">
                            <button class="btn btn-danger btn-sm" onclick="return confirm('Deseja excluir?')">Excluir</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
<%- include('../partials/footer'); %>