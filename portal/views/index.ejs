<%- include('partials/header') %>
<div class="container my-5">
  <h2 class="h4 mb-4">Novidades em Tempo Real (RSS)</h2>
  <div class="row g-4">
    <% if (noticiasRSS && noticiasRSS.length >0) { %>
      <% noticiasRSS.forEach(item => { %>
        <div class="col-md-4">
          <div class="card h-100 shadow-sm card-noticia">
            <div class="card-body d-flex flex-column"> 
              <h5 class="card-title fs-6"><%= item.title %></h5>
              <p class="card-text text-muted small flex-grow-1"><%= item.contentSnipper %></p>
              <a class="btn btn-outline-primary btn-sm" target="_blank" href="<%= item.link %>">Acessar notícia</a>
            </div>
          </div>
      </div>   
      <% }) %>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>